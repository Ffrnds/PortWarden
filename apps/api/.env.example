# Copy this file to .env and adjust as needed — all variables have sane
# defaults for local development, so a .env file is optional.

# HTTP port the API listens on.
PORT=3000

# Where the SQLite database (port history + protected ports) is stored.
DATABASE_PATH=./data/port-manager.sqlite

# JWT signing secret and the access key POST /api/auth/login accepts to
# issue a token. Both default to a random value generated fresh on every
# process boot if left unset — fine for this single-user, localhost-only
# desktop tool (see src/config/env.js for the reasoning). Set these only if
# a token needs to remain valid across an API restart.
# JWT_SECRET=
# ADMIN_ACCESS_KEY=

# Optional: caches the netstat/tasklist snapshot for a couple seconds
# behind Redis instead of an in-memory Map. Only worth setting if you're
# already running `docker compose up` (see docker-compose.yml, service
# "redis", bound to host port 6380 to avoid colliding with anything else).
# Falls back to an in-memory cache automatically if unset or unreachable —
# never required for the app to work.
# REDIS_URL=redis://localhost:6380
