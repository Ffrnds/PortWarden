{
  "title": "Port Manager",
  "uid": "port-manager",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Processes terminated (total)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "port_manager_processes_terminated_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Terminations over time",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "port_manager_processes_terminated_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API process CPU usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(process_cpu_user_seconds_total[5m])", "refId": "A", "legendFormat": "user CPU time/sec" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API process memory (RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes", "refId": "A" }]
    }
  ]
}
